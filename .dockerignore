# Keep the build context small and secrets out of the image.
.git
.github
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache

# Secrets: configuration is supplied at runtime, never baked in.
.env
.env.*
!.env.example

# Not needed at runtime
tests
documents
eval/results
*.md
!README.md
docker-compose.yml
Dockerfile
.dockerignore
