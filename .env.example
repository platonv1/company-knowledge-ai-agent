# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- Branding ----
JARVIS_NAME=Jarvis
COMPANY_NAME=Jarvis Financial Group

# ---- Database ----
# Matches docker-compose.yml defaults
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5433/jarvis

# ---- Providers ----
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_FAST_MODEL=gpt-4o-mini

# ---- Embeddings ----
# local   : runs on this machine via ONNX. No API key, no network, free.
#           384 dimensions -- the schema is migrated to match.
# openai  : text-embedding-3-small, 1536 dimensions. Needs API credit AND a
#           migration back to 1536 (alembic downgrade f10d30736545), then a re-index.
# hashing : bag-of-words, offline. For tests only; it cannot match paraphrases.
#
# Changing provider or model ALWAYS requires `ingest_documents --reset`:
# vectors from different models are not comparable, and a mixed index returns
# confident nonsense rather than failing.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

OPENAI_API_KEY=

# ---- Retrieval tuning ----
# NOTE: RELEVANCE_FLOOR is calibrated PER EMBEDDING MODEL against
# eval/golden_set.yaml (see README). Do not raise it to 0.70 -- cosine scores for
# text-embedding-3-small put relevant text around 0.40-0.65, so a 0.70 floor
# refuses almost everything.
#   EMBEDDING_PROVIDER=local    -> calibrate with run_eval --sweep
#   EMBEDDING_PROVIDER=openai   -> 0.35 (estimate, never measured)
#   EMBEDDING_PROVIDER=hashing  -> 0.20  (offline dev only; weaker separation)
SEARCH_K=8
TOP_K=5
RELEVANCE_FLOOR=0.35
RELATIVE_DROPOFF=0.75

# ---- Chunking ----
CHUNK_TARGET_TOKENS=600
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_RATIO=0.12

# ---- Conversation ----
HISTORY_WINDOW_MESSAGES=6

# ---- Security ----
ADMIN_API_KEY=change-me-in-production
CORS_ALLOWED_ORIGINS=http://localhost:8000
CHAT_RATE_LIMIT_PER_MINUTE=20
