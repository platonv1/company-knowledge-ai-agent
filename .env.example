# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- Branding ----
JARVIS_NAME=Jarvis
COMPANY_NAME=Jarvis Financial Group

# ---- Database ----
# Matches docker-compose.yml defaults
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5433/jarvis

# ---- Providers ----
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_FAST_MODEL=gpt-4o-mini

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

OPENAI_API_KEY=

# ---- Retrieval tuning ----
# NOTE: RELEVANCE_FLOOR is calibrated PER EMBEDDING MODEL against
# eval/golden_set.yaml (see README). Do not raise it to 0.70 -- cosine scores for
# text-embedding-3-small put relevant text around 0.40-0.65, so a 0.70 floor
# refuses almost everything.
#   EMBEDDING_PROVIDER=openai   -> 0.35
#   EMBEDDING_PROVIDER=hashing  -> 0.20  (offline dev only; weaker separation)
SEARCH_K=8
TOP_K=5
RELEVANCE_FLOOR=0.35
RELATIVE_DROPOFF=0.75

# ---- Chunking ----
CHUNK_TARGET_TOKENS=600
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_RATIO=0.12

# ---- Conversation ----
HISTORY_WINDOW_MESSAGES=6

# ---- Security ----
ADMIN_API_KEY=change-me-in-production
CORS_ALLOWED_ORIGINS=http://localhost:8000
CHAT_RATE_LIMIT_PER_MINUTE=20
